{
  "name": "research-overview",
  "version": "1.0.0",
  "description": "Reproducible CDD Research Studio overview video",
  "repository": {},
  "license": "MPL-2.0",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/web": "0.0.354",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "tsc",
    "render": "remotion render ResearchOverview ../../docs/media/cdd-research-overview.mp4",
    "poster": "remotion still ResearchOverview ../../docs/media/cdd-research-overview-poster.png --frame=90",
    "render:cc11": "remotion render CC11Launch ../../docs/cc11/media/cc11-launch-film.mp4 --codec=h264 --crf=18",
    "render:cc11:vertical": "remotion render CC11LaunchVertical ../../docs/cc11/media/cc11-launch-vertical.mp4 --codec=h264 --crf=18",
    "poster:cc11": "remotion still CC11Launch ../../docs/cc11/media/cc11-launch-poster.png --frame=840"
  },
  "sideEffects": [
    "*.css"
  ]
}
